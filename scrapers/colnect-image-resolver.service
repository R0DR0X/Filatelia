[Unit]
Description=Colnect Image Resolver Service
After=network.target

[Service]
Type=simple
User=rodrigo
WorkingDirectory=/home/rodrigo/filatelia
Environment=PATH=/home/rodrigo/filatelia/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/rodrigo/filatelia/.venv/bin/python -u scrapers/image_resolver.py
Restart=always
RestartSec=5
StandardOutput=append:/home/rodrigo/filatelia/logs/image_resolver.log
StandardError=append:/home/rodrigo/filatelia/logs/image_resolver.log

[Install]
WantedBy=multi-user.target

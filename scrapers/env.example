# Credentials for the scrapers. Copy this file to `scrapers/.env`, fill in the
# values, and `source` it before running anything. `.env` is gitignored; this
# file is not, so it must never hold a real value.
#
# Every one of these is read at startup and the script exits immediately with a
# clear message if it is missing. Nothing here has a fallback baked into the
# code any more — that is what leaked in the first place.

# Service token for the Worker's admin surface. Any script that writes to
# /import-stamp or /upload-image needs it. Same value as the Worker secret and
# the Pages environment variable.
ADMIN_API_TOKEN=

# OpenRouter key used by 04-ai-enricher.mjs. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# DataImpulse residential proxy, from the dashboard at https://dataimpulse.com
# The host normally looks like gw.dataimpulse.com:823
DATAIMPULSE_HOST=
DATAIMPULSE_USER=
DATAIMPULSE_PASS=

# Colnect account used to crawl as a signed-in user rather than a guest, which
# is rate-limited harder. Only needed by the login and cookie-refresh scripts.
COLNECT_USERNAME=
COLNECT_PASSWORD=
